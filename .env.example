# Copier ce fichier en .env et remplir les valeurs.
# .env ne doit JAMAIS être committé (voir .gitignore).

# Supabase — depuis Project Settings > API
SUPABASE_URL=
SUPABASE_ANON_KEY=
# ⚠️ SECRET : accès total à la base. Ne jamais exposer au navigateur.
# En production, la mettre dans les variables d'environnement Vercel, pas ici.
SUPABASE_SERVICE_ROLE_KEY=

# Source du contenu pour le build : "files" (fiches Markdown) ou "supabase"
CONTENT_SOURCE=files

# URL publique du site (base des liens SEO / sitemap)
SITE_BASE_URL=https://comoresnews.com

# Deploy Hook Vercel (créé dans Vercel > Settings > Git > Deploy Hooks)
VERCEL_DEPLOY_HOOK_URL=
